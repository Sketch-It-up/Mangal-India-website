# Copy to .env.local for local development, and set the same names in the hosting dashboard.
# Nothing here is required to run `npm run dev`: without an endpoint, forms are logged, not sent.

# --- Browser (VITE_ prefix: these end up in the public JavaScript; never put secrets here) ---

# GA4 measurement ID. When set, the cookie banner appears and analytics load only after "Accept".
VITE_GA4_ID=

# Optional: send enquiries to a different backend or form service instead of /api/enquiry.
# If it is on another domain, add that domain to connect-src in vercel.json.
VITE_ENQUIRY_ENDPOINT=

# Demo only: send enquiries straight from the browser with EmailJS (emailjs.com).
# When all three IDs are set, this replaces /api/enquiry. Leave them unset in production.
# These are public values; the EmailJS private key is never needed here.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
# Owner inbox, passed to the template as {{to_email}}.
VITE_EMAILJS_TO_EMAIL=

# --- Server (api/enquiry.js) ---

# Email delivery through Resend (resend.com). ENQUIRY_FROM must be on a verified domain.
RESEND_API_KEY=
ENQUIRY_FROM="Mangal India Website <enquiries@example.com>"

# Team inbox per form (Section 13 routing). [CONFIRM: team email addresses]
ENQUIRY_TO_DOMESTIC=      # A: Indian wholesale buyers -> domestic sales
ENQUIRY_TO_EXPORT=        # B: international buyers -> export desk
ENQUIRY_TO_SOURCING=      # C: international suppliers -> sourcing
ENQUIRY_TO_MARKETING=     # D: Dubai shop updates -> marketing
ENQUIRY_TO_GENERAL=       # Contact page "Other"
ENQUIRY_TO_DEFAULT=       # fallback for any form without its own inbox

# Optional: every enquiry is also POSTed here as JSON (CRM, Google Sheet automation, database).
ENQUIRY_WEBHOOK_URL=
